{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "index.js",
      "installCommand": "npm ci --omit=optional"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "api" } }],
  "regions": ["fra1"]
}
