# ─── Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ──────────────────────────────────────────
DB_URL=mongodb://localhost:27017/cartify
DB_URL_ONLINE=mongodb+srv://<user>:<password>@cluster.mongodb.net/cartify

# ─── Auth ──────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Email (Gmail App Password) ────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_SENDER_PASSWORD=your_16_char_app_password

# ─── Cloudinary ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── MQTT (Smart Return Boxes) ─────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
# For authenticated brokers:
# MQTT_USERNAME=your_mqtt_user
# MQTT_PASSWORD=your_mqtt_password
# For TLS (production):
# MQTT_BROKER_URL=mqtts://broker.example.com:8883
# MQTT_CA_CERT_PATH=./certs/ca.crt

# ─── SmartBox drop-off check (free, runs locally) ──────
# Weight + CLIP image check on every box photo. The model (~150 MB) downloads once.
# AI_VERIFY=off
# AI_VISION_MODEL=Xenova/clip-vit-base-patch32

# ─── AI: demand forecasting service (ai-service/) ──────
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=replace_with_long_random_secret          # same value as in the ai-service environment
# AI_SERVICE_TIMEOUT_MS=120000     # max time for one forecasting run (a run takes about 1 min on 4 cores)
# On the ai-service itself: FORECAST_PROPHET=off skips the Prophet candidates (faster, but less accurate on the demo data)
# FORECAST_DATA_SOURCE=auto        # auto | orders | synthetic_demo (auto = real orders once there is enough history)
# FORECAST_LOOKBACK_DAYS=730
# FORECAST_LEAD_TIME_DAYS=7        # days for a delivery or transfer to arrive
# FORECAST_SERVICE_LEVEL=0.95      # safety-stock service level (0.9, 0.95, 0.975, 0.99)
# SAFETY_STOCK_MIN_DAYS=3
# EXCESS_COVER_DAYS=60
# MIN_TRANSFER_QTY=2
# LOW_STOCK_UNITS=5                # low-stock threshold before any forecast exists
# INVENTORY_SNAPSHOTS=on           # daily stock snapshot (off on serverless; call POST /inventory/snapshots from a cron)

# ─── AI: shopping assistant + inventory agent (free, local: Ollama) ─
# Runs an open-source model on your own machine/server: no API key, no per-request fee.
# Install Ollama (https://ollama.com), set OLLAMA_NO_CLOUD=1 for it, then: ollama pull qwen3:4b-instruct
# Model choice and measurements: docs/AI_FEATURES.md, section 9.1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct      # 8 GB+ RAM, CPU only. 16 GB+ RAM: gemma4:e4b (faster). Smaller models (qwen3:1.7b) failed the tool tests
# OLLAMA_NUM_CTX=8192               # context window (tokens); more = more RAM
# OLLAMA_THINK=off                  # "on" lets hybrid Qwen3 models reason first (slower, CPU not recommended)
# OLLAMA_TEMPERATURE=0.4
# OLLAMA_KEEP_ALIVE=30m             # keep the model in memory between chats
# OLLAMA_TIMEOUT_MS=240000          # max time for one model call
# OLLAMA_MAX_CONCURRENT=1           # model calls at the same time (raise with a GPU / OLLAMA_NUM_PARALLEL)
# OLLAMA_MAX_QUEUE=8                # chats waiting for the model before "busy" is returned
# OLLAMA_WARMUP=on                  # load the model when the server starts
# ASSISTANT_RATE_LIMIT_PER_MIN=15   # chat messages per user/session per minute
# INTERNAL_API_URL=                # how agent tools reach this API (default http://127.0.0.1:$PORT; set to the public URL on serverless)
